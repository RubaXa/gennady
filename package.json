{
  "name": "gennady",
  "version": "0.8.4-next.3",
  "author": "Konstantin Lebedev <ibnrubaxa@gmail.com>",
  "description": "Gennady — General Extensible Neural Network Adaptive Data Yntelligence",
  "keywords": [
    "git",
    "ai",
    "llm",
    "local",
    "commit",
    "generator",
    "gennady",
    "review",
    "code-review"
  ],
  "license": "MIT",
  "repository": "https://github.com/rubaxa/gennady",
  "type": "module",
  "bin": "./dist/gennady.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#snapshot-path-setup": "./snapshot-path.setup.ts",
    "#logger": "./services/logger/logger.ts",
    "#utils/*": "./utils/*"
  },
  "exports": {
    ".": "./services/agent-mon/index.ts",
    "./stack": "./services/stack/plugin-api.ts",
    "./providers/claude": "./services/agent-mon/providers/claude/index.ts",
    "./providers/opencode": "./services/agent-mon/providers/opencode/index.ts"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "docs/**/*",
    "ai/**/*",
    "cli/cmd/orient/README.md",
    "services/agent-run/engines/opencode/readonly.config.json",
    "plugins/*/plugin.json",
    "plugins/*/*.ts",
    "plugins/*/directives/**/*",
    "plugins/*/skills/**/*"
  ],
  "scripts": {
    "slides": "node ai/drafts/slides/360/build-slides.js",
    "slides:serve": "node ai/drafts/slides/360/build-slides.js --serve",
    "slides:pdf": "node ai/drafts/slides/360/build-slides.js --pdf",
    "prepare": "[ -d .git ] && git config core.hooksPath scripts/git-hooks || true",
    "type-check": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.types.json && node --import tsx scripts/normalize-dts-imports.ts",
    "build:publish": "npm run build && npm run build:types && node --import tsx scripts/prepare-publish-artifacts.ts",
    "test": "node --import tsx --test --experimental-test-module-mocks",
    "test:e2e": "GENNADY_E2E=1 node --import tsx --test --experimental-test-module-mocks cli/__tests__/e2e/*.test.ts",
    "test:cli-e2e": "GENNADY_E2E=1 node --import tsx --test --experimental-test-module-mocks cli/__tests__/e2e/*.test.ts",
    "test:stack-e2e": "node --import tsx scripts/stack-e2e.ts",
    "test:config-e2e": "node --import tsx scripts/stack-e2e.ts --suite=config",
    "test:smoke": "GENNADY_SMOKE=1 node --import tsx --test --experimental-test-module-mocks cli/__tests__/e2e/bundle-smoke.e2e.test.ts cli/__tests__/e2e/publish-contents.e2e.test.ts",
    "test:integration": "node --import tsx --test --experimental-test-module-mocks --test-concurrency=2 services/agent-inbox/serve/__tests__/*.test.ts services/agent-inbox/modules/*/__tests__/*.integration.test.ts services/agent-inbox/modules/inbox-api/__tests__/http-server.test.ts services/agent-inbox/modules/inbox-roles/__tests__/reviewer.e2e.test.ts services/agent-inbox/modules/inbox-eval/__tests__/eval-driver.test.ts services/mr-stats/__tests__/*.integration.test.ts",
    "test:watch": "tsx --test-loader 'cli/**/*.test.ts' 'shared/**/*.test.ts' 'services/**/*.test.ts'",
    "dev": "tsx cli/gennady.ts",
    "inspector": "tsx ai/inspector/generate.ts && tsx ai/inspector/serve.ts",
    "inspector:gen": "tsx ai/inspector/generate.ts",
    "inspector:serve": "tsx ai/inspector/serve.ts",
    "inspector:test": "node --import tsx --test ai/inspector/core/__tests__/*.test.ts ai/inspector/web/__tests__/*.test.ts",
    "inbox": "npm run inbox-serve:build && tsx cli/gennady.ts inbox serve --auto-review-quiet-minutes=15",
    "inbox-serve:dev": "vite --config services/agent-inbox/modules/inbox-dashboard/vite.config.ts",
    "inbox-serve:build": "vite build --config services/agent-inbox/modules/inbox-dashboard/vite.config.ts",
    "inspector:e2e": "playwright test --config=ai/inspector/playwright.config.ts",
    "test:e2e:review-flow": "playwright test --config=e2e/inbox-serve/playwright.review-flow.config.ts",
    "test:e2e:prod": "playwright test --config=e2e/inbox-serve/playwright.prod.config.ts",
    "build": "vite build",
    "prepublishOnly": "npm run lint && npm run test:smoke && npm run test:cli-e2e && CONFIG_E2E_STRICT=1 npm run test:config-e2e && STACK_E2E_STRICT=1 npm run test:stack-e2e && npm run build:publish",
    "postpublish": "node --import tsx scripts/cleanup-publish-artifacts.ts",
    "publish-next": "node --import tsx scripts/publish-next.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run format && npm run type-check && npm run lint:contracts",
    "release": "release-it",
    "lint:contracts": "tsx cli/gennady.ts lint --autofix cli/ shared/ services/ plugins/"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@fontsource/geist": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@mtcute/dispatcher": "^0.29.0",
    "@mtcute/node": "^0.28.2",
    "@opencode-ai/sdk": "^1.17.18",
    "@playwright/cli": "^0.1.17",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "ai": "^6.0.116",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-glob": "^3.3.3",
    "grammy": "^1.45.1",
    "handlebars": "^4.7.9",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.6",
    "open": "^11.0.0",
    "prettier": "^3.4.2",
    "qrcode": "^1.5.4",
    "release-it": "20.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.19.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "yaml": "2.9.0",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "ink": "^7.0.3",
    "mermaid": "^11.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tree-sitter": "^0.22.4",
    "tree-sitter-typescript": "^0.23.2"
  }
}
