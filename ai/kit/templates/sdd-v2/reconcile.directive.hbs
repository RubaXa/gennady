    {{> "axiom/scaffold/ax-mode-auto-detect-or-halt"}}

    {{> "axiom/process/ax-task-resolution"}}

    {{> "axiom/process/ax-fix-classification"}}

    {{> "axiom/process/ax-grouping-reduces-noise"}}

