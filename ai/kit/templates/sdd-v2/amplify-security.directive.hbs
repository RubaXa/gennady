<SddAmplifySecurity keywords="security, amplify, threat-model, trust-boundaries, authn, authz, secrets, input-validation, pii, data-classification, sca, sdd-amplify-security" type="directive" ver="2.0">
  <Mission>
    Deepen the security posture of a scope spec under discovery — threat model lite: trust
    boundaries, authn/authz model, secrets handling, input validation at external boundaries,
    PII / data classification, dependency risk (delegated to SCA tooling). Loaded lazily by the
    discovery interview's triage when the scope touches external input, user accounts, or
    sensitive data; inherits the session core (language, dialogue, safeguard, no-narration) — not
    repeated here.

    Input — the scope spec draft + interview context. Output — a filled `Security` subsection
    inside Requirements & Constraints (`SECURITY_SECTION_FORMAT`) + follow-up items appended to
    the discovery interview map. Out of scope: pentest planning, infra hardening runbooks — the
    spec records decisions, not procedures.
  </Mission>

  <BeliefState deps="AX_OPERATOR_LANGUAGE, AX_OPERATOR_SAFEGUARD, AX_NO_PROCESS_NARRATION">
    {{> "axiom/process/ax-amplify-defaults-first"}}

    {{> "axiom/spec/ax-decision-log-required"}}

    {{> "axiom/spec/ax-external-input-untrusted"}}

    {{> "axiom/infra/ax-secrets-discipline"}}
  </BeliefState>

  <HaltConditions>
    | 🛑 ID | Trigger |
    |---|---|
    | `H_NO_SECURITY_SURFACE` | Triage misfired: no trust boundary, no stored user data — report and return control |
    | `H_OPERATOR_REJECTS_DEFAULTS` | Operator declines the whole defaults package and skips deep-dive — leave the spec untouched |
  </HaltConditions>

  <ExecutionPlan>
    <Step id="STEP_0_PROPOSE_DEFAULTS">
      <Goal>Assemble the security defaults package for this product class.</Goal>
      <Action>
        From the spec draft, map the attack surface: trust boundaries, entry points, stored data
        classes. Per `AX_AMPLIFY_DEFAULTS_FIRST`, draft one default decision per topic — boundaries
        + validation (per `AX_EXTERNAL_INPUT_UNTRUSTED`), authn/authz model, secrets handling (per
        `AX_SECRETS_DISCIPLINE`), PII classification, SCA delegation — grounded in what live
        products of this class ship; short targeted research when class practice is uncertain.
        Zero surface found → `H_NO_SECURITY_SURFACE`.
      </Action>
    </Step>
    <Step id="STEP_1_AGREE">
      <Goal>One accept-or-edit gate; deep-dive only on explicit pick.</Goal>
      <Action>
        Present the package as ONE reply per `AX_AMPLIFY_DEFAULTS_FIRST` (AskUserQuestion when
        available, else `QUESTION_FORMAT`); each topic accept / edit / deep-dive. For topics the
        operator marks deep-dive, interview by the topic map: boundaries → authn/authz → secrets →
        validation → PII → dependencies. Untouched topics keep their defaults. STOP.
      </Action>
    </Step>
    <Step id="STEP_2_APPLY">
      <Goal>Write the agreed decisions into the spec.</Goal>
      <Action>
        `READ_AND_USE_DIRECTIVE("ai/directives/sdd-v2/formats/security-section-format.xml")` and
        write the `Security` subsection into Requirements & Constraints of the scope spec.
        Non-default picks and notable accepted defaults → Decision Log per
        `AX_DECISION_LOG_REQUIRED`. Topics left unresolved after deep-dive → items on the
        discovery interview map. Return control to the interview.
      </Action>
    </Step>
  </ExecutionPlan>

  <ChatOutput>
    Service line — dim, internal, never narrated (`AX_NO_PROCESS_NARRATION`):
    `🛡️ AMP_SEC · topics=<n> · accepted=<n> · edited=<n> · dive=<n>`.
  </ChatOutput>
</SddAmplifySecurity>
