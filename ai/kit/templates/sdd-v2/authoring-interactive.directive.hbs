<SddAuthoringInteractive keywords="authoring, interactive, approval, dialogue" type="directive" ver="2.0">
  <Mission>
    Optional live-operator profile. Load only when the operator explicitly requests interactive
    authoring. Autonomous runs never load this file.
  </Mission>
  <ExecutionPlan>
    <Step id="STEP_1_REVIEW">
      <Goal>Show the actual checked artifacts, not a hypothetical plan.</Goal>
      <Action>
        Present bounded deltas and only diagrams that materially clarify a decision. Ask one cohesive
        question. Breadcrumbs are allowed here. Do not duplicate section guidance.
      </Action>
    </Step>
    <Step id="STEP_2_APPROVAL">
      <Goal>Capture the live approval boundary.</Goal>
      <Action>
        Approval Check over current artifact paths and bytes. STOP only while awaiting the operator;
        after the answer return control to the owning scope/module route.
      </Action>
    </Step>
  </ExecutionPlan>
</SddAuthoringInteractive>
